      "filter_name": "byActivePublishedPricing",
      "where_clause_parameters": ["current_date"],
      "columns_to_fetch": ["publish_price", "publish_effective_date", "current_price", "current_effective_date"],
      "code_snippet": "com.google.common.collect.Multimap<String, Object> queryParams = com.google.common.collect.ArrayListMultimap.create(); queryParams.put(\"current_date\", context.getCurrentDate()); context.streamDataFromDB(\"cu_rer_engine_pricing\", \"byActivePublishedPricing\", queryParams, record -> { eligiblePricingRecords.add(record); });",
      "purpose": "Query and stream all pricing ledger records where published prices are active and their effective timelines are less than or equal to the current system date."
    }
  ],
  "conditional_routing": [
    {
      "condition": "published price and effective date are populated and the effective date has been reached or passed relative to the system date",
