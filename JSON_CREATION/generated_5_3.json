{
    "requestFields": [
        "warehouse_code"
    ],
    "dbCalls": [
        {
            "id": 1,
            "name": "WarehouseData",
            "consumes": [
                "Request"
            ],
            "entity": "warehouse",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "warehouse_code",
                    "rightSource": "Request.warehouse_code"
                }
            ],
            "produces": [
                "warehouse_capacity",
                "current_inventory_level",
                "warehouse_region"
            ]
        },
        {
            "id": 2,
            "name": "InventoryPolicy",
            "consumes": [
                "WarehouseData"
            ],
            "entity": "inventory_policy",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "warehouse_region",
                    "rightSource": "WarehouseData.warehouse_region"
                }
            ],
            "produces": [
                "safety_stock_percentage",
                "replenishment_category",
                "uuid"
            ]
        }
    ],
    "calculations": [
        {
            "name": "InventorySafetyStockCalculation",
            "consumes": [
                "Request",
                "WarehouseData",
                "InventoryPolicy"
            ],
            "steps": [
                {
                    "description": "Calculate requiredSafetyStock = WarehouseData.warehouse_capacity * InventoryPolicy.safety_stock_percentage / 100"
                }
            ],
            "conditions": [
                {
                    "condition": "No records exist for WarehouseData",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "No records exist for InventoryPolicy",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "WarehouseData.current_inventory_level < requiredSafetyStock",
                    "output": {
                        "operation": "UPDATE",
                        "entity": "inventory_policy",
                        "targetRecord": {
                            "uuid": "${InventoryPolicy.uuid}"
                        },
                        "fieldMappings": [
                            {
                                "sourceField": "WarehouseData.current_inventory_level",
                                "targetField": "current_inventory_level"
                            },
                            {
                                "sourceField": "InventoryPolicy.replenishment_category",
                                "targetField": "replenishment_category"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "updated_date"
                            }
                        ]
                    }
                },
                {
                    "condition": "WarehouseData.current_inventory_level >= requiredSafetyStock",
                    "output": {
                        "operation": "INSERT",
                        "entity": "inventory_status",
                        "targetRecord": {},
                        "fieldMappings": [
                            {
                                "sourceField": "Request.warehouse_code",
                                "targetField": "warehouse_code"
                            },
                            {
                                "sourceField": "WarehouseData.warehouse_region",
                                "targetField": "warehouse_region"
                            },
                            {
                                "sourceField": "WarehouseData.current_inventory_level",
                                "targetField": "current_inventory_level"
                            },
                            {
                                "sourceField": "requiredSafetyStock",
                                "targetField": "required_safety_stock"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "created_date"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}