          "suspended_profile": { "carrierStatus": "SUSPENDED", "riskTierCode": "CORRIDOR_TIER_3", "extremeSpendVarianceFlag": false },
          "variance_detected": { "carrierStatus": "ACTIVE", "riskTierCode": "CORRIDOR_TIER_3", "extremeSpendVarianceFlag": true }
        }
      },
      {
        "step_reference": 3,
