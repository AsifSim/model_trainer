          "persistence_verifications": [
            {
              "target_entity": "CoPayCapMatrix",
              "expected_operation": "update",
              "expected_fields": {
                "uuid": "mock-uuid-777-ccc",
                "adjudication_status": "MAXIMIZER_HOLD"
              }
            }
          ]
        }
      }
    ]
  }
}