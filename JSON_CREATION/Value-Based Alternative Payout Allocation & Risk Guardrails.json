        "mock_target": "QualityScoreEfficacyService/v1",
        "mock_outputs": {
          "happy_path": { "contractStatus": "ACTIVE", "clinicalPerformanceTierCode": "TIER_1_OPTIMAL", "extremeSpendVarianceFlag": false },
          "default_profile": { "contractStatus": "DEFAULT", "clinicalPerformanceTierCode": "TIER_4_SUBSTANDARD", "extremeSpendVarianceFlag": false },
          "variance_detected": { "contractStatus": "ACTIVE", "clinicalPerformanceTierCode": "TIER_4_SUBSTANDARD", "extremeSpendVarianceFlag": true }
        }
      },
      {
        "step_reference": 3,
