{
    "requestFields": [
        "part_number"
    ],
    "dbCalls": [
        {
            "id": 1,
            "name": "PartPricingData",
            "consumes": [
                "Request"
            ],
            "entity": "part_pricing",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "part_number",
                    "rightSource": "Request.part_number"
                }
            ],
            "produces": [
                "list_price",
                "net_price",
                "customer_segment"
            ]
        },
        {
            "id": 2,
            "name": "PricingGuidance",
            "consumes": [
                "PartPricingData"
            ],
            "entity": "pricing_guidance",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "customer_segment",
                    "rightSource": "PartPricingData.customer_segment"
                }
            ],
            "produces": [
                "recommended_discount_percentage",
                "uuid"
            ]
        }
    ],
    "calculations": [
        {
            "name": "PricingComplianceCalculation",
            "consumes": [
                "Request",
                "PartPricingData",
                "PricingGuidance"
            ],
            "steps": [
                {
                    "description": "Calculate realizedDiscount = ((PartPricingData.list_price - PartPricingData.net_price) * 100) / PartPricingData.list_price"
                }
            ],
            "conditions": [
                {
                    "condition": "No records exist for PartPricingData",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "No records exist for PricingGuidance",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "realizedDiscount > PricingGuidance.recommended_discount_percentage",
                    "output": {
                        "operation": "UPDATE",
                        "entity": "pricing_guidance",
                        "targetRecord": {
                            "uuid": "${PricingGuidance.uuid}"
                        },
                        "fieldMappings": [
                            {
                                "sourceField": "realizedDiscount",
                                "targetField": "observed_discount_percentage"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "updated_date"
                            }
                        ]
                    }
                },
                {
                    "condition": "realizedDiscount <= PricingGuidance.recommended_discount_percentage",
                    "output": {
                        "operation": "INSERT",
                        "entity": "pricing_compliance",
                        "targetRecord": {},
                        "fieldMappings": [
                            {
                                "sourceField": "Request.part_number",
                                "targetField": "part_number"
                            },
                            {
                                "sourceField": "PartPricingData.customer_segment",
                                "targetField": "customer_segment"
                            },
                            {
                                "sourceField": "realizedDiscount",
                                "targetField": "realized_discount_percentage"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "created_date"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}