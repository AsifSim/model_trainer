        {
          "type": "STEP_OUTPUT",
          "source_step": 1,
          "source_entity": "xpricing_admin_owner",
          "extracted_field": "id",
          "mapped_to_where_parameter": "pricing_admin_owner_id"
        }
      ],
      "columns_to_fetch": ["uuid", "ecc", "name", "pricing_admin_owner"],
      "code_snippet": "com.google.common.collect.Multimap<String, Object> queryParams2 = com.google.common.collect.ArrayListMultimap.create(); queryParams2.put(\"name\", name); queryParams2.put(\"pricing_admin_owner\", ownerIdHolder[0]); context.streamDataFromDB(\"part_noun_name_ecc_xref\", \"byNameAndPricingAdminOwner\", queryParams2, record -> { xrefRecordsList.add(record); });",
      "purpose": "Query cross-reference schemas using the explicit strict criteria of matching name and matching internal owner identifier."
    },
    {
      "step_number": 3,
      "type": "DATABASE_STREAM",
      "target_entity": "part_noun_name_ecc_xref",
      "filter_name": "byPartNameOnly",
      "where_clause_parameters": ["name"],
      "data_dependencies": [
        {
          "type": "REQUEST_DATA",
          "field_name": "name"
        }
      ],
      "columns_to_fetch": ["uuid", "ecc", "name", "pricing_admin_owner"],
      "code_snippet": "com.google.common.collect.Multimap<String, Object> queryParams3 = com.google.common.collect.ArrayListMultimap.create(); queryParams3.put(\"name\", name); context.streamDataFromDB(\"part_noun_name_ecc_xref\", \"byPartNameOnly\", queryParams3, record -> { nameOnlyRecordsList.add(record); });",
      "purpose": "Query cross-reference layers using the fallback validation step filtering solely on part noun name definitions."
    }
  ],
