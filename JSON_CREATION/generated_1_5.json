{
    "requestFields": [
        "order_number"
    ],
    "dbCalls": [
        {
            "id": 1,
            "name": "OrderData",
            "consumes": [
                "Request"
            ],
            "entity": "customer_order",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "order_number",
                    "rightSource": "Request.order_number"
                }
            ],
            "produces": [
                "customer_type",
                "order_amount",
                "sales_region"
            ]
        },
        {
            "id": 2,
            "name": "DiscountPolicy",
            "consumes": [
                "OrderData"
            ],
            "entity": "discount_policy",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "customer_type",
                    "rightSource": "OrderData.customer_type"
                },
                {
                    "leftField": "sales_region",
                    "rightSource": "OrderData.sales_region"
                }
            ],
            "produces": [
                "discount_percentage",
                "approval_level",
                "uuid"
            ]
        }
    ],
    "calculations": [
        {
            "name": "DiscountCalculation",
            "consumes": [
                "Request",
                "OrderData",
                "DiscountPolicy"
            ],
            "steps": [
                {
                    "description": "Calculate discountAmount = OrderData.order_amount * DiscountPolicy.discount_percentage / 100"
                }
            ],
            "conditions": [
                {
                    "condition": "No records exist for OrderData",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "No records exist for DiscountPolicy",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "discountAmount > 1000",
                    "output": {
                        "operation": "UPDATE",
                        "entity": "discount_policy",
                        "targetRecord": {
                            "uuid": "${DiscountPolicy.uuid}"
                        },
                        "fieldMappings": [
                            {
                                "sourceField": "discountAmount",
                                "targetField": "discount_amount"
                            },
                            {
                                "sourceField": "DiscountPolicy.approval_level",
                                "targetField": "approval_level"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "updated_date"
                            }
                        ]
                    }
                },
                {
                    "condition": "discountAmount <= 1000",
                    "output": {
                        "operation": "INSERT",
                        "entity": "discount_summary",
                        "targetRecord": {},
                        "fieldMappings": [
                            {
                                "sourceField": "Request.order_number",
                                "targetField": "order_number"
                            },
                            {
                                "sourceField": "OrderData.customer_type",
                                "targetField": "customer_type"
                            },
                            {
                                "sourceField": "OrderData.sales_region",
                                "targetField": "sales_region"
                            },
                            {
                                "sourceField": "DiscountPolicy.discount_percentage",
                                "targetField": "discount_percentage"
                            },
                            {
                                "sourceField": "discountAmount",
                                "targetField": "discount_amount"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "created_date"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}