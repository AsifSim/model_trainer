{
    "requestFields": [
        "supplier_code"
    ],
    "dbCalls": [
        {
            "id": 1,
            "name": "SupplierData",
            "consumes": [
                "Request"
            ],
            "entity": "supplier",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "supplier_code",
                    "rightSource": "Request.supplier_code"
                }
            ],
            "produces": [
                "supplier_rating",
                "supplier_region",
                "total_orders"
            ]
        },
        {
            "id": 2,
            "name": "RegionThreshold",
            "consumes": [
                "SupplierData"
            ],
            "entity": "region_threshold",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "supplier_region",
                    "rightSource": "SupplierData.supplier_region"
                }
            ],
            "produces": [
                "minimum_rating",
                "preferred_supplier_flag",
                "uuid"
            ]
        }
    ],
    "calculations": [
        {
            "name": "SupplierQualification",
            "consumes": [
                "Request",
                "SupplierData",
                "RegionThreshold"
            ],
            "steps": [
                {
                    "description": "Calculate qualifies = SupplierData.supplier_rating >= RegionThreshold.minimum_rating AND SupplierData.total_orders > 100"
                }
            ],
            "conditions": [
                {
                    "condition": "No records exist for SupplierData",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "No records exist for RegionThreshold",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                },
                {
                    "condition": "qualifies = true",
                    "output": {
                        "operation": "UPDATE",
                        "entity": "region_threshold",
                        "targetRecord": {
                            "uuid": "${RegionThreshold.uuid}"
                        },
                        "fieldMappings": [
                            {
                                "sourceField": "SupplierData.supplier_rating",
                                "targetField": "supplier_rating"
                            },
                            {
                                "sourceField": "SupplierData.total_orders",
                                "targetField": "total_orders"
                            },
                            {
                                "sourceField": "RegionThreshold.preferred_supplier_flag",
                                "targetField": "preferred_supplier_flag"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "updated_date"
                            }
                        ]
                    }
                },
                {
                    "condition": "qualifies = false",
                    "output": {
                        "operation": "INSERT",
                        "entity": "supplier_review",
                        "targetRecord": {},
                        "fieldMappings": [
                            {
                                "sourceField": "Request.supplier_code",
                                "targetField": "supplier_code"
                            },
                            {
                                "sourceField": "SupplierData.supplier_rating",
                                "targetField": "supplier_rating"
                            },
                            {
                                "sourceField": "SupplierData.supplier_region",
                                "targetField": "supplier_region"
                            },
                            {
                                "sourceField": "SupplierData.total_orders",
                                "targetField": "total_orders"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "created_date"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}