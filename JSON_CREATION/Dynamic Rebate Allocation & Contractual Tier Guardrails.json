        "given_request_data": { "wholesalerAccountId": "WHL-808", "totalPurchaseVolume": 500000.00, "formularyDrugId": "DRUG-101" },
        "simulated_profiles": ["breach_profile", "standard_row"],
        "assertions": {
          "microservice_invocations": [
            { "microservice": "ContractReviewBoardService/v1", "expected_calls": 1 }
