          "persistence_verifications": [
            {
              "target_entity": "RebateThresholdMatrix",
              "expected_operation": "update",
              "expected_fields": {
                "uuid": "mock-uuid-555-eee",
                "adjudication_status": "REBATE_HOLD"
              }
            }
          ]
        }
      }
    ]
  }
}