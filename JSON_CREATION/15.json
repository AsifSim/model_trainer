{
  "requestFields": [
    "technical_configuration",
    "marketing_configuration",
    "fuel_rating_hp"
  ],
  "dbCalls": [
    {
      "id": 1,
      "name": "CurrentPricing",
      "consumes": [
        "Request"
      ],
      "entity": "cu_rer_engine_pricing",
      "streaming": false,
      "dynamicJoinModel": null,
      "joins": [
        {
          "leftField": "technical_configuration",
          "rightSource": "Request.technical_configuration"
        },
        {
          "leftField": "marketing_configuration",
          "rightSource": "Request.marketing_configuration"
        },
        {
          "leftField": "fuel_rating_hp",
          "rightSource": "Request.fuel_rating_hp"
        }
      ],
      "produces": [
        "uuid",
        "current_price",
        "publish_price",
        "pricing_action",
        "currency"
      ]
    },
    {
      "id": 2,
      "name": "DefaultPricingAction",
      "consumes": [
        "CurrentPricing"
      ],
      "entity": "p_pricing_action",
      "streaming": false,
      "dynamicJoinModel": null,
      "joins": [
        {
          "leftField": "code",
          "rightSource": "None"
        }
      ],
      "produces": [
        "id"
      ]
    },
    {
      "id": 3,
      "name": "ConfigurationData",
      "consumes": [
        "Request"
      ],
      "entity": "configuration",
      "streaming": false,
      "dynamicJoinModel": null,
      "joins": [
        {
          "leftField": "code",
          "rightSource": "Request.technical_configuration"
        }
      ],
      "produces": [
        "engine_model",
        "displacement_liters",
        "certification_level",
        "market_application",
        "engine_type"
      ]
    },
    {
      "id": 4,
      "name": "SuggestedPriceConfiguration",
      "consumes": [
        "ConfigurationData",
        "Request"
      ],
      "entity": "cu_suggested_prices_rer_engine",
      "streaming": false,
      "dynamicJoinModel": null,
      "joins": [
        {
          "leftField": "engine_model",
          "rightSource": "ConfigurationData.engine_model"
        },
        {
          "leftField": "displacement_liters",
          "rightSource": "ConfigurationData.displacement_liters"
        },
        {
          "leftField": "certification_level",
          "rightSource": "ConfigurationData.certification_level"
        },
        {
          "leftField": "market_application",
          "rightSource": "ConfigurationData.market_application"
        },
        {
          "leftField": "engine_type",
          "rightSource": "ConfigurationData.engine_type"
        },
        {
          "leftField": "fuel_rating_hp",
          "rightSource": "Request.fuel_rating_hp"
        }
      ],
      "produces": [
        "pricing_method",
        "pricing_method_value"
      ]
    }
  ],
  "calculations": [
    {
      "name": "PricingPreparation",
      "consumes": [
        "Request",
        "CurrentPricing",
        "DefaultPricingAction",
        "ConfigurationData",
        "SuggestedPriceConfiguration"
      ],
      "steps": [
        {
          "description": "Validate pricing record exists and uuid is present"
        },
        {
          "description": "If currency is null or blank, default currency to USD"
        },
        {
          "description": "If pricing_action is null or blank, fetch pricing action where code = None and use its id"
        },
        {
          "description": "Determine basePrice = publish_price when available, otherwise current_price"
        },
        {
          "description": "If pricing_method = Value Based then suggestedFuturePrice = basePrice + pricing_method_value"
        },
        {
          "description": "If pricing_method = Percentage Based then suggestedFuturePrice = basePrice * (1 + pricing_method_value / 100)"
        }
      ],
      "conditions": [
        {
          "condition": "No records exist for CurrentPricing",
          "output": {
            "operation": "RETURN",
            "entity": "",
            "targetRecord": {},
            "fieldMappings": []
          }
        },
        {
          "condition": "CurrentPricing.uuid is null or blank",
          "output": {
            "operation": "RETURN",
            "entity": "",
            "targetRecord": {},
            "fieldMappings": []
          }
        },
        {
          "condition": "Pricing record exists",
          "output": {
            "operation": "UPDATE",
            "entity": "cu_rer_engine_pricing",
            "targetRecord": {
              "uuid": "${CurrentPricing.uuid}"
            },
            "fieldMappings": [
              {
                "sourceField": "resolvedPricingAction",
                "targetField": "pricing_action"
              },
              {
                "sourceField": "USD",
                "targetField": "currency",
                "condition": "CurrentPricing.currency is null or blank"
              },
              {
                "sourceField": "ConfigurationData.engine_model",
                "targetField": "engine_model"
              },
              {
                "sourceField": "ConfigurationData.displacement_liters",
                "targetField": "displacement_liters"
              },
              {
                "sourceField": "ConfigurationData.certification_level",
                "targetField": "certification_level"
              },
              {
                "sourceField": "ConfigurationData.market_application",
                "targetField": "market_application"
              },
              {
                "sourceField": "ConfigurationData.engine_type",
                "targetField": "engine_type"
              },
              {
                "sourceField": "Request.fuel_rating_hp",
                "targetField": "fuel_rating_hp"
              },
              {
                "sourceField": "Request.technical_configuration",
                "targetField": "technical_configuration"
              },
              {
                "sourceField": "Request.marketing_configuration",
                "targetField": "marketing_configuration"
              },
              {
                "sourceField": "suggestedFuturePrice",
                "targetField": "suggested_future_price",
                "condition": "suggestedFuturePrice is calculated"
              },
              {
                "sourceField": "CURRENT_TIMESTAMP",
                "targetField": "updated_date"
              }
            ]
          }
        }
      ]
    }
  ]
}