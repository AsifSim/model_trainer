{
    "requestFields": [
        "short_part_number"
    ],
    "dbCalls": [
        {
            "id": 1,
            "name": "OptionChildValidation",
            "consumes": [
                "Request"
            ],
            "entity": "cu_wc_option_child",
            "streaming": true,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "child_part",
                    "rightSource": "Request.short_part_number"
                }
            ],
            "produces": [
                "rev_option_no"
            ]
        },
        {
            "id": 2,
            "name": "PartRecord",
            "consumes": [
                "Request"
            ],
            "entity": "part",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "short_part_number",
                    "rightSource": "Request.short_part_number"
                }
            ],
            "produces": [
                "code"
            ]
        },
        {
            "id": 3,
            "name": "CustomPalantirPart",
            "consumes": [
                "PartRecord"
            ],
            "entity": "custom_palantir_part",
            "streaming": false,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "part_number",
                    "rightSource": "PartRecord.code"
                }
            ],
            "produces": [
                "uuid"
            ]
        },
        {
            "id": 4,
            "name": "OptionChildData",
            "consumes": [
                "Request"
            ],
            "entity": "cu_wc_option_child",
            "streaming": true,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "child_part",
                    "rightSource": "Request.short_part_number"
                }
            ],
            "produces": [
                "rev_option_no"
            ]
        },
        {
            "id": 5,
            "name": "OptionConfigNotes",
            "consumes": [
                "OptionChildData"
            ],
            "entity": "cu_esn_bom_option_config_notes",
            "streaming": true,
            "dynamicJoinModel": null,
            "joins": [
                {
                    "leftField": "option_assembly_num",
                    "rightSource": "OptionChildData.rev_option_no"
                }
            ],
            "produces": [
                "build_year",
                "design_config_num"
            ]
        }
    ],
    "calculations": [
        {
            "name": "LatestConfigurationCalculation",
            "consumes": [
                "OptionConfigNotes"
            ],
            "steps": [
                {
                    "description": "Extract distinct rev_option_no values from OptionChildData"
                },
                {
                    "description": "Fetch OptionConfigNotes using option_assembly_num IN rev_option_no list"
                },
                {
                    "description": "Find maximum build_year from OptionConfigNotes"
                },
                {
                    "description": "Filter OptionConfigNotes where build_year = maxBuildYear"
                },
                {
                    "description": "Group filtered records by design_config_num"
                },
                {
                    "description": "Count occurrences of each design_config_num"
                },
                {
                    "description": "Select design_config_num with highest count as latestConfiguration"
                }
            ],
            "conditions": [
                {
                    "condition": "No records exist for PartRecord",
                    "output": {
                        "operation": "RETURN",
                        "entity": "",
                        "targetRecord": {},
                        "fieldMappings": []
                    }
                }
            ]
        },
        {
            "name": "CustomPalantirPartUpsert",
            "consumes": [
                "Request",
                "PartRecord",
                "CustomPalantirPart",
                "LatestConfigurationCalculation"
            ],
            "steps": [],
            "conditions": [
                {
                    "condition": "No record exists for CustomPalantirPart OR uuid is null",
                    "output": {
                        "operation": "INSERT",
                        "entity": "custom_palantir_part",
                        "targetRecord": {},
                        "fieldMappings": [
                            {
                                "sourceField": "PartRecord.code",
                                "targetField": "part_number"
                            },
                            {
                                "sourceField": "maxBuildYear",
                                "targetField": "last_year_esn_produced"
                            },
                            {
                                "sourceField": "latestConfiguration",
                                "targetField": "latest_configuration"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "created_date"
                            },
                            {
                                "sourceField": "commercial_exit",
                                "targetField": "created_by"
                            },
                            {
                                "sourceField": "CURRENT_TIMESTAMP",
                                "targetField": "updated_date"
                            },
                            {
                                "sourceField": "commercial_exit",
                                "targetField": "updated_by"
                            }
                        ]
                    }
                },
                {
                    "condition": "Record exists for CustomPalantirPart AND uuid is not null",
                    "output": {
                        "operation": "UPDATE",
                        "entity": "custom_palantir_part",
                        "targetRecord": {
                            "uuid": "${CustomPalantirPart.uuid}"
                        },
                        "fieldMappings": [
                            {
                                "sourceField": "maxBuildYear",
                                "targetField": "last_year_esn_produced"
                            },
                            {
                                "sourceField": "latestConfiguration",
                                "targetField": "latest_configuration"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}